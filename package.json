{
  "name": "quant-math-textbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build pipeline for 量化数学进阶教材",
  "scripts": {
    "content:inventory": "node tools/content/parse-book.mjs",
    "content:build": "node tools/content/build-content.mjs",
    "content:validate": "node tools/content/validate-content.mjs",
    "content:graph": "node tools/content/build-graph.mjs",
    "content:paths": "node tools/content/build-paths.mjs",
    "content:sync": "node tools/content/sync-web.mjs",
    "metadata:validate": "node tools/content/validate-metadata.mjs",
    "test:content": "node --test tools/content/*.test.mjs"
  },
  "dependencies": {
    "katex": "0.16.22",
    "marked": "15.0.12",
    "pagedjs": "0.4.3"
  }
}
